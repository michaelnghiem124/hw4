# Copy to .env and fill in real values. NEVER commit the real .env — it is gitignored.
#
# The backend also reads ~/.config/mgt409/.env first (shared across the course's
# projects), then a local .env, without overriding anything already in the
# environment. Either location works.

# Required. Your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Optional. Overrides the default model (claude-sonnet-4-6).
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional. HMAC key used to sign chat session tokens (backend/security.py).
# If unset, the backend generates one on first run and stores it in
# backend/.session_secret (mode 0600, gitignored). Set this explicitly in any
# real deployment so tokens survive a redeploy.
CAMPUS_CUSTOMS_SECRET=replace-with-a-long-random-hex-string
